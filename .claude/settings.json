{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(uv:*)", "Bash(just:*)", "Bash(ruff:*)", "Bash(pyright:*)",
      "Bash(pytest:*)", "Bash(git:*)", "Bash(gh:*)", "Bash(npm:*)", "Bash(ollama:*)"
    ],
    "ask": [ "Bash(curl:*)", "Bash(wget:*)" ],
    "deny": [
      "Bash(flyctl:*)", "Bash(render:*)", "Bash(railway:*)", "Bash(gcloud:*)",
      "Bash(aws:*)", "Read(./.env)", "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_paid_services.sh" }] },
      { "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_restricted_paths.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff_format.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "just check-cost" }] }
    ]
  }
}
